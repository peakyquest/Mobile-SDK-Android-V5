<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/uxsdk_mission_picker_dialog_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/uxsdk_mission_type_title"
        android:textColor="@color/uxsdk_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/uxsdk_mission_picker_waypoint_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/uxsdk_mission_picker_card_bg"
            android:gravity="center_horizontal"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/way"
                android:contentDescription="@string/uxsdk_mission_type_waypoint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_waypoint_title"
                android:textColor="@color/uxsdk_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_waypoint_subtitle"
                android:textColor="@color/uxsdk_white_60_percent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uxsdk_mission_picker_hotpoint_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/uxsdk_mission_picker_card_bg"
            android:gravity="center_horizontal"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/uxsdk_ic_overview_status"
                android:contentDescription="@string/uxsdk_mission_type_hotpoint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_hotpoint_title"
                android:textColor="@color/uxsdk_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_hotpoint_subtitle"
                android:textColor="@color/uxsdk_white_60_percent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uxsdk_mission_picker_mapping_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/uxsdk_mission_picker_card_bg"
            android:gravity="center_horizontal"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/terrain"
                android:contentDescription="@string/uxsdk_mission_picker_mapping_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_mapping_title"
                android:textColor="@color/uxsdk_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/uxsdk_mission_picker_mapping_subtitle"
                android:textColor="@color/uxsdk_white_60_percent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
