<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/uxsdk_mission_picker_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/uxsdk_default_layout_map_style_title"
        style="@style/UXSDKDefaultLayoutDialogTitleText" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/uxsdk_default_layout_map_style_subtitle"
        style="@style/UXSDKDefaultLayoutDialogSubtitleText" />

    <LinearLayout
        android:id="@+id/uxsdk_map_style_row_standard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/uxsdk_mission_picker_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uxsdk_default_layout_map_style_normal_title"
            style="@style/UXSDKDefaultLayoutMapOptionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/uxsdk_default_layout_map_style_normal_desc"
            style="@style/UXSDKDefaultLayoutMapOptionDesc" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/uxsdk_map_style_row_satellite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/uxsdk_mission_picker_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uxsdk_default_layout_map_style_satellite_title"
            style="@style/UXSDKDefaultLayoutMapOptionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/uxsdk_default_layout_map_style_satellite_desc"
            style="@style/UXSDKDefaultLayoutMapOptionDesc" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/uxsdk_map_style_row_hybrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/uxsdk_mission_picker_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uxsdk_default_layout_map_style_hybrid_title"
            style="@style/UXSDKDefaultLayoutMapOptionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/uxsdk_default_layout_map_style_hybrid_desc"
            style="@style/UXSDKDefaultLayoutMapOptionDesc" />
    </LinearLayout>
</LinearLayout>
