<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/uxsdk_mission_picker_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/uxsdk_default_layout_fly_zones_title"
        style="@style/UXSDKDefaultLayoutDialogTitleText" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/uxsdk_default_layout_fly_zones_subtitle"
        style="@style/UXSDKDefaultLayoutDialogSubtitleText" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/uxsdk_fly_zone_cb_authorization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/uxsdk_default_layout_fly_zone_cat_authorization"
                android:textColor="@color/uxsdk_white"
                android:textSize="15sp"
                app:buttonTint="@color/uxsdk_default_layout_checkbox_tint" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/uxsdk_fly_zone_cb_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/uxsdk_default_layout_fly_zone_cat_warning"
                android:textColor="@color/uxsdk_white"
                android:textSize="15sp"
                app:buttonTint="@color/uxsdk_default_layout_checkbox_tint" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/uxsdk_fly_zone_cb_enhanced_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/uxsdk_default_layout_fly_zone_cat_enhanced"
                android:textColor="@color/uxsdk_white"
                android:textSize="15sp"
                app:buttonTint="@color/uxsdk_default_layout_checkbox_tint" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/uxsdk_fly_zone_cb_restricted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/uxsdk_default_layout_fly_zone_cat_restricted"
                android:textColor="@color/uxsdk_white"
                android:textSize="15sp"
                app:buttonTint="@color/uxsdk_default_layout_checkbox_tint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
