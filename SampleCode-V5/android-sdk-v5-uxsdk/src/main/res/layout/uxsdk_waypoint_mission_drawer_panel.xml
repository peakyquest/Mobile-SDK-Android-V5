<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uxsdk_fpv_popover_content_background_color"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:theme="@style/uxsdk_waypoint_drawer_theme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uxsdk_waypoint_drawer_title"
            android:textColor="@color/uxsdk_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/uxsdk_waypoint_drawer_btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/uxsdk_waypoint_drawer_close"
            android:tint="@color/uxsdk_white"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/uxsdk_waypoint_drawer_nav_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/uxsdk_white"
        android:textSize="14sp"
        tools:text="Waypoint 1 / 3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/uxsdk_waypoint_drawer_btn_prev"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
            android:text="@string/uxsdk_waypoint_drawer_prev"
            android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />

        <Button
            android:id="@+id/uxsdk_waypoint_drawer_btn_next"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
            android:text="@string/uxsdk_waypoint_drawer_next"
            android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />
    </LinearLayout>

    <!-- Single scroll region: form + mission + summary so altitude/speed are never squeezed off-screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uxsdk_waypoint_drawer_section_wp"
                android:textStyle="bold" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_altitude_m" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uxsdk_waypoint_drawer_et_altitude"
                style="@style/uxsdk_waypoint_drawer_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="30"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_speed_ms" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uxsdk_waypoint_drawer_et_speed"
                style="@style/uxsdk_waypoint_drawer_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_gimbal_pitch" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/uxsdk_waypoint_drawer_et_gimbal"
                style="@style/uxsdk_waypoint_drawer_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="-30"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_drawer_heading" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/uxsdk_waypoint_drawer_sp_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_drawer_action" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/uxsdk_waypoint_drawer_sp_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_drawer_turn" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/uxsdk_waypoint_drawer_sp_turn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/uxsdk_waypoint_drawer_btn_apply_wp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
                android:text="@string/uxsdk_waypoint_drawer_apply_wp"
                android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />

            <Button
                android:id="@+id/uxsdk_waypoint_drawer_btn_delete_wp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
                android:text="@string/uxsdk_waypoint_delete"
                android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />

            <TextView
                android:id="@+id/uxsdk_waypoint_drawer_mission_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/uxsdk_mission_globals_title"
                android:textColor="@color/uxsdk_white"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/uxsdk_waypoint_drawer_mission_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/uxsdk_waypoint_drawer_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uxsdk_mission_finish_action" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/uxsdk_waypoint_drawer_sp_finish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    style="@style/uxsdk_waypoint_drawer_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/uxsdk_mission_rc_lost_action" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/uxsdk_waypoint_drawer_sp_rc_lost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    style="@style/uxsdk_waypoint_drawer_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/uxsdk_waypoint_global_speed_ms" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/uxsdk_waypoint_drawer_et_global_speed"
                    style="@style/uxsdk_waypoint_drawer_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <TextView
                style="@style/uxsdk_waypoint_drawer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/uxsdk_waypoint_drawer_summary_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uxsdk_waypoint_drawer_tv_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/uxsdk_white"
                android:textSize="13sp"
                tools:text="Total: 3" />

            <TextView
                android:id="@+id/uxsdk_waypoint_drawer_tv_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/uxsdk_white"
                android:textSize="13sp"
                tools:text="Distance: 120 m" />

            <TextView
                android:id="@+id/uxsdk_waypoint_drawer_tv_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/uxsdk_white"
                android:textSize="13sp"
                tools:text="Est. time: 24 s" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/uxsdk_waypoint_drawer_api_note"
                android:textColor="@color/uxsdk_white_70_percent"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/uxsdk_waypoint_drawer_upload_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressTint="@color/uxsdk_white"
        android:visibility="invisible" />

    <Button
        android:id="@+id/uxsdk_waypoint_drawer_btn_upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
        android:text="@string/uxsdk_waypoint_drawer_upload"
        android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />

    <Button
        android:id="@+id/uxsdk_waypoint_drawer_btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
        android:enabled="false"
        android:text="@string/uxsdk_waypoint_drawer_start"
        android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />

    <Button
        android:id="@+id/uxsdk_waypoint_drawer_btn_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/uxsdk_waypoint_drawer_btn_outline"
        android:text="@string/uxsdk_waypoint_drawer_exit_mission"
        android:textColor="@color/uxsdk_waypoint_drawer_btn_text" />
</LinearLayout>
