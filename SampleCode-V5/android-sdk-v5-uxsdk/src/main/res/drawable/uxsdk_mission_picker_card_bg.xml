<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/uxsdk_white_20_percent" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/uxsdk_white_30_percent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/uxsdk_white_10_percent" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/uxsdk_white_20_percent" />
        </shape>
    </item>
</selector>
